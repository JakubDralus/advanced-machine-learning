    "\n",
    "external_models = {\n",
    "    'XGBoost': XGBClassifier(random_state=42),\n",
    "    'CatBoost': CatBoostClassifier(random_state=42, verbose=0),\n",
    "}\n",
    "\n",
    "# Combine all models into a single dictionary\n",
    "models = sklearn_models | external_models\n",
    "models"
