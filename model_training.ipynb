    "        restored_datasets[key] = df\n",
    "\n",
    "print(\"\\nRestored datasets keys:\\n\")\n",
    "for k, _ in restored_datasets.items():\n",
    "    print( k)\n",
    "\n",
    "base_dataset = pd.read_csv('scaled_data/base.csv')\n",
    "scaled_datasets = restored_datasets | {'base': base_dataset}"
